{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "teenliwa",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "0b7dc087410628baa1f652ea0fb8bd57",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "vars": {
    "R2_BUCKET": "bt-liwa",
    "FREE_DELIVERY_THRESHOLD": "250",
    "STANDARD_DELIVERY_FEE": "30",
    "ZIINA_TEST_MODE": "true"
  },
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "bt-liwa" }
  ],
  "d1_databases": [
    {
      "binding": "TEENLIWA_V2",
      "database_name": "teenliwa-v2",
      "database_id": "7912cd75-0a35-4bdc-9aa0-6679ca80d20d",
      "migrations_dir": "./migrations-v2"
    }
  ]
}
